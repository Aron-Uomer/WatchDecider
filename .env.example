VITE_TMDB_API_KEY=your_tmdb_api_key_here

# --- NODEMAILER (SMTP) CONFIG ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# --- FIREBASE ADMIN CONFIG ---
# Option 1: Path to your JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-account.json"
# Option 2: Inline JSON (for production platforms like Railway/Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- CORS (comma-separated origins allowed in production) ---
# CORS_ORIGIN=https://yourdomain.com